data/runs/**/replay/*.json filter=lfs diff=lfs merge=lfs -text
data/submissions/**/replay/*.json filter=lfs diff=lfs merge=lfs -text
data/replays/**/*.json filter=lfs diff=lfs merge=lfs -text
data/logs/**/*.json filter=lfs diff=lfs merge=lfs -text
data/submissions/*.zip filter=lfs diff=lfs merge=lfs -text
* !text !filter !merge !diff
