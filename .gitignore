# Archived experiments
/archive/

# Kaggle result logs and analysis outputs are kept in Git.
# Large replay archives are routed through Git LFS by .gitattributes.

# Bulk battle logs and superseded training data. These blew past the GitHub
# LFS budget (4GB) and nothing in the repo reads them, so they live on local
# disk only. Regenerate replays by re-running the ladder; regenerate the
# processed matrices from the raw replays.
data/runs/leaderboard_top50/
data/runs/local_self_play/
data/ml/alakazam_ml_v5/processed/
data/ml/alakazam_ml_v6/processed/
data/ml/alakazam_ml_v7/processed/
data/ml/alakazam_ml_v7_candidate/processed/
data/ml/alakazam_ml_v8_candidate/processed/
data/ml/alakazam_v4_candidate/processed.zip

# Own submission run archives default to local-only: each one is 5-200MB of
# LFS payload. The three most recent are already tracked and stay tracked
# (.gitignore does not untrack). To share a new one deliberately:
#   git add -f data/runs/alakazam/<archive>.zip
data/runs/alakazam/

# Scratch space for ad-hoc analysis runs
/.tmp/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Regeneratable ML matrix feature arrays (exceed GitHub LFS 2GB limit)
data/ml/**/processed/matrix/features.npy

# Teacher corpus caches. Regenerate with scripts/build_alakazam_v33_corpus.py
# from the teacher index, which is committed. These exceed GitHub's 100 MB
# hard push limit (v34's is 102 MB) and this repo does not use Git LFS.
experiments/**/*.npz

# Grimmsnarl top-50 replay archive: ~24 GB of raw episode JSON. Refetch with
# scripts/collect_top100_submission_replays.py from the submission list in
# data/kaggle_top50_meta/analysis/submissions_grimmsnarl.csv.
data/kaggle_grimmsnarl_top50/

# Grimmsnarl training intermediates. The corpus cache is 69 MB and the raw
# LightGBM boosters are 8-52 MB each; all are regenerable with
# scripts/build_grimmsnarl_v1_corpus.py and scripts/train_grimmsnarl_v1_teacher.py.
# The distilled runtime model that the agent actually loads IS committed, at
# agents/grimmsnarl/grimmsnarl_ml_v1/ranker_model.json.
data/ml/grimmsnarl/processed/
data/ml/grimmsnarl/models/

# Local Codex/Claude settings
/.claude/settings.local.json

# Regeneratable replay corpora and ladder runs
/data/kaggle_top40_alakazam/
/data/kaggle_top50_meta/logs/
/data/kaggle_top50_meta/replays/
/data/runs/grimmsnarl/
/data/runs/leaderboard_refresh/
/data/runs/lopunny/
/data/runs/lopunny.zip